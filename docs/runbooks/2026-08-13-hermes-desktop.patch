+def _desktop_linux_userns_sandbox_works() -> bool:
+    """Return True when Chromium can build its namespace sandbox unaided.
+
+    Chromium only falls back to the SUID helper when it cannot create a user
+    namespace, so on a host that allows them the helper is dead weight — and
+    demanding it costs a sudo prompt that a launcher started from a menu entry
+    has no terminal to answer.
+
+    The probe must nest: Chromium's real gate is
+    ``Credentials::CanCreateProcessInNewUserNS()``, which writes uid_map/gid_map,
+    drops capabilities and then tries a *second*, inner namespace. A bare
+    ``unshare --user`` succeeds on hosts where that inner step fails, so it
+    would report a sandbox that Chromium then refuses to use.
+    """
+    unshare = shutil.which("unshare")
+    if not unshare:
+        return False
+    try:
+        probe = subprocess.run(
+            [unshare, "--user", "--map-root-user", unshare, "--user", "true"],
+            capture_output=True,
+            timeout=10,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return False
+    return probe.returncode == 0
+
