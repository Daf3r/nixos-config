     if sandbox_lstat.st_uid == 0 and stat.S_IMODE(sandbox_lstat.st_mode) == 0o4755:
         return True
 
+    # Every desktop rebuild recreates this helper as a plain 0755 file owned by
+    # the user, so a host that can sandbox through user namespaces would be
+    # asked for sudo on every single launch — impossible from a menu entry,
+    # which has neither a terminal nor an askpass helper. Leave the helper
+    # alone in that case: Chromium picks the namespace sandbox on its own.
+    if _desktop_linux_userns_sandbox_works():
