+def test_exec_prefers_local_bin_shim_when_it_is_not_on_path(
+    tmp_path, xdg_home, monkeypatch
+):
+    """The installed shim wins even when PATH never picked up its directory.
+
+    The installer drops the shim in ``~/.local/bin``, but a login shell
+    that never adds that directory to PATH leaves ``shutil.which`` with
+    nothing to find. The fallback then hands back the checkout
+    entrypoint, whose ``#!/usr/bin/env python3`` shebang resolves to the
+    system interpreter -- which has none of Hermes' dependencies. The
+    menu entry dies with ModuleNotFoundError before any window appears,
+    and ``Terminal=false`` means the traceback is never shown: clicking
+    the icon does nothing at all.
+    """
+    root = _make_project(tmp_path)
+    home = tmp_path / "home"
+    shim = home / ".local" / "bin" / "hermes"
+    shim.parent.mkdir(parents=True)
+    shim.write_text("#!/usr/bin/env bash\n", encoding="utf-8")
+    shim.chmod(0o755)
+
+    monkeypatch.setenv("HOME", str(home))
+    monkeypatch.setattr(lde.shutil, "which", lambda _name: None)
+    monkeypatch.setattr(
+        "hermes_cli.relaunch.resolve_hermes_bin", lambda: str(root / "hermes")
+    )
+    monkeypatch.setattr(lde, "refresh_desktop_databases", lambda _dir: [])
+
+    entry = lde.install_desktop_entry(root)
+    values = _parse(entry.read_text(encoding="utf-8"))
+
+    assert values["Exec"] == f"{shim} desktop"
+
+
 def test_install_is_idempotent_and_skips_cache_refresh(tmp_path, xdg_home, monkeypatch):
