     return project_root / "apps" / "desktop" / "assets" / "icon.png"
 
 
+def _installed_shim() -> str | None:
+    """Absolute path of the installed ``hermes`` shim, or None.
+
+    PATH alone is not a reliable way to find it. The installer writes the
+    shim to ``~/.local/bin``, and on a host whose login shell never adds
+    that directory to PATH, ``shutil.which`` comes up empty even though
+    the shim is sitting right there. So look in the install directory
+    directly once PATH has failed.
+    """
+    candidates = (shutil.which("hermes"), str(Path.home() / ".local" / "bin" / "hermes"))
+    for candidate in candidates:
+        if candidate and Path(candidate).is_file() and os.access(candidate, os.X_OK):
+            return candidate
+    return None
+
