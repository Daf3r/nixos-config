{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "height": 18,
    "padding": {
      "top": 2,
      "right": 6
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
    "break",
    { "type": "title", "keyWidth": 10 },
    "break",
    { "type": "os", "key": " " },
    { "type": "kernel", "key": " " },
    { "type": "packages", "key": " " },
    { "type": "shell", "key": " " },
    { "type": "terminal", "key": " " },
    { "type": "wm", "key": " " },
    { "type": "cursor", "key": " " },
    { "type": "terminalfont", "key": " " },
    { "type": "uptime", "key": " " },
    { "type": "datetime", "format": "{1}-{3}-{11}", "key": " " },
    { "type": "media", "key": "󰝚 " },
    { "type": "player", "key": " " },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
    "break"
  ]
}
