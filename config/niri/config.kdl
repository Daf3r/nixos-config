// niri — scrollable-tiling Wayland compositor, and the only session on this
// machine since 2026-08-07. It replaced Hyprland, which ran alongside it for a
// while as the fallback and was removed once niri had proven itself as the
// daily driver.
//
// The paradigm is genuinely different. Windows live in one
// infinite horizontal strip per workspace and you scroll along it instead of
// splitting a fixed screen. Nothing ever resizes to make room for a new window.
// That maps well onto editor-plus-browser, which is most of the work on this
// machine; it maps badly onto anything expecting a fixed-size fullscreen surface,
// which is why the CS2 note at the bottom matters.
//
// KDL format: https://kdl.dev — "/-" comments out the following node.
// Validate after editing with:  niri validate -c ~/.config/niri/config.kdl

input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }

    touchpad {
        tap
        // Natural scrolling stays off. Omitting natural-scroll disables it,
        // so there is deliberately no line for it here.
        dwt
    }

    // Do not warp the pointer onto a newly focused window. With two monitors
    // this otherwise yanks the cursor across the desk unprompted.
    focus-follows-mouse max-scroll-amount="0%"
}

// Physical layout: laptop panel on the LEFT, external MSI on the RIGHT.
//
// eDP-1 at scale 1.6 gives a 1600x900 logical size — 2560/1.6 and 1440/1.6 are
// both integers, so no fractional-scaling blur. That is also why HDMI-A-1 starts
// at x=1600 and not x=2560: niri positions outputs in logical, scaled pixels.
// The refresh rate must match a mode niri actually reports, to three decimals.
// "2560x1440@240" and "1920x1080@100" both looked right and were both silently
// rejected — niri logged
//   configured mode 2560x1440@240 could not be found, falling back to preferred
// and ran the 240 Hz panel at 60. Worse than cosmetic: it then throttled vblanks
// to match the 60 Hz it believed in, while the panel was scanning out at ~129 Hz.
//
// Get the exact strings from `niri msg outputs` inside a niri session — the
// rounded numbers a human would write are the ones that get rejected.
// Outputs are matched by "make model serial", NOT by connector name.
//
// The connector name is not stable on this machine. It was eDP-1 when this file
// was written and came up as eDP-2 after the next reboot, with no hardware or
// configuration change — the NVIDIA driver simply numbered its eDP connector
// differently. There are two eDP connectors in the system (one per GPU), which
// is what makes the index shift possible.
//
// The consequence was total: with the block keyed on a name that no longer
// existed, niri ignored mode, scale and position outright. The 240 Hz panel came
// up at 60 and got auto-placed to the *right* of the MSI at x=3520, which is why
// the monitors appeared swapped.
//
// These strings are what `niri msg outputs` prints in quotes. They come from the
// EDID and do not change.
// `y=180` aligns the two panels by their *bottom* edge, and is not cosmetic.
//
// "The cursor can only move between directly adjacent outputs" — so wherever one
// output is taller than its neighbour, the leftover band has nothing to cross
// into and the pointer hits a wall. This panel is 1600x900 logical at scale 1.6;
// the MSI is 1920x1080. Aligned at the top, the bottom 180 logical pixels of the
// MSI — a sixth of its height — had no eDP beside them, and dragging the cursor
// left along the bottom of the monitor simply stopped.
//
// 1080 - 900 = 180 moves that band to the top edge instead, where it also
// matches the desk: the monitor stands above the laptop's own panel.
//
// The band cannot be removed by positioning, only relocated — that would need
// the two logical heights to match, i.e. scale 1.2 on the MSI (1600x900, giant
// on a 24") or scale 1.3333 here (1920x1080, everything a fifth smaller).
output "California Institute of Technology MNH301CA3-1 Unknown" {
    mode "2560x1440@240.002"
    scale 1.6
    position x=0 y=180
    variable-refresh-rate on-demand=true
}

output "Microstep MSI MP243X PB5H735601263" {
    mode "1920x1080@99.999"
    scale 1
    position x=1600 y=0
}

layout {
    gaps 10

    // Where a new column lands relative to the focused one.
    center-focused-column "never"

    // Widths cycled through with Mod+R. Two thirds and a half cover the common
    // editor-plus-browser splits on a 1600px-wide laptop screen.
    preset-column-widths {
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    // Half width, so two terminals sit side by side with no keypresses at all —
    // which is the arrangement that gets used.
    //
    // This went back and forth. It started at 0.5, moved to 1.0 because a lone
    // window with dead space beside it looks broken rather than tiled, and came
    // back here once it was clear that side-by-side is the normal case and a
    // full-screen single window is the exception. niri cannot have both
    // automatically: it never subdivides the screen to fit a new window, so the
    // width a window opens at is the width it keeps.
    //
    // The exception is cheap: Mod+R cycles up through the presets above, and
    // Mod+F fullscreens outright.
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        // Colours are overridden by noctalia.kdl at the bottom of this file.
        active-color "#39bae6"
        inactive-color "#1e222a"
    }

    border {
        off
    }

    shadow {
        on
        softness 20
        spread 4
        offset x=0 y=4
        color "#0006"
    }

    struts {
        // Noctalia's bar is a layer-surface with reserve_space, so niri already
        // accounts for it. Left at zero deliberately.
    }
}

// DankMaterialShell is the shell: the bar, the launcher, the OSD and the lock
// screen. Configured in ../../dms.nix.
//
// Deliberately NOT spawned here, unlike Noctalia before it: DMS ships a systemd
// user unit (programs.dank-material-shell.systemd.enable in ../../dms.nix) bound
// to graphical-session.target, which restarts it if it dies. Adding a
// spawn-at-startup line as well would launch two shells.

// awww (called swww until nixpkgs 26.11 renamed it) draws the wallpaper because
// Noctalia v5.0.0 mis-sizes its own wallpaper
// surface at fractional scales, and eDP-1 runs at 1.6. See ../../wallpaper.nix
// for the full write-up.
spawn-at-startup "awww-daemon"
spawn-at-startup "wallpaper-rotate" "--watch"

// XWayland is NOT spawned here on purpose. niri 25.11 integrates
// xwayland-satellite itself: it opens the X11 sockets and spawns the satellite
// on demand when the first X11 client connects, so the binary only needs to be
// on PATH (desktops.nix installs it).
//
// If X11 apps — Steam and CS2 above all — fail to start, check the niri log for
//   "xwayland-satellite doesn't support on-demand activation, disabling integration"
// which means the on-demand handshake failed. The fallback is to start it
// eagerly and hand DISPLAY to children instead:
//
//   spawn-at-startup "xwayland-satellite" ":0"
//   environment { DISPLAY ":0"; }

environment {
    // Set here because SDDM execs the compositor directly, so nothing sources
    // the shell profile that home-manager's home.pointerCursor writes these
    // into. Keep in step with ../../gtk.nix.
    //
    // The matching HYPRCURSOR_THEME/SIZE pair was dropped with Hyprland: niri
    // has no hyprcursor support at all, so they named a format nothing here
    // can load.
    XCURSOR_THEME "Bibata-Modern-Ice"
    XCURSOR_SIZE "24"

    NIXOS_OZONE_WL "1"
}

prefer-no-csd

// Matches shell.screenshot.directory in ../../noctalia.nix. niri has its own
// screenshot UI bound below; Noctalia's IPC verbs also still work.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

animations {
    slowdown 1.0
}

// CS2. Launch options: EMPTY. It runs on its own Wayland path and works.
//
// This is worth writing down because the obvious advice is wrong here. niri is
// non-stacking, and upstream warns that games misbehave under one — cursor
// escaping on multi-monitor setups, wrong resolution, failed input grabs — with
// gamescope as the recommended wrapper. Tried that first and it broke the game:
// CS2 initialised Vulkan and then never presented a window.
//
// The cause is gamescope on NVIDIA, not niri and not CS2:
//
//   vulkan: vkGetPhysicalDeviceFormatProperties2 returned zero modifiers
//           for DRM format 0x38344241
//
// The driver exposes no DRM format modifiers for the formats gamescope wants to
// allocate its output buffers in, so it renders and has nowhere to put the
// result. Reproducible with `gamescope -- sleep 3` — nothing to do with Steam.
//
// If gamescope is ever needed again, `--backend sdl` gets past it: with that
// backend gamescope selects the 4060 and reports modifier support. Verified,
// though not needed so far. Resolution and stretching go in CS2's own video
// settings, not in gamescope.
window-rule {
    match app-id=r#"^cs2$"#
    open-fullscreen true
    variable-refresh-rate true
}

// gamescope itself, when CS2 is wrapped in it.
window-rule {
    match app-id=r#"^gamescope$"#
    open-fullscreen true
    variable-refresh-rate true
}

// Steam. Note the matching semantics: properties inside ONE `match` are ANDed,
// separate `match` directives are ORed. An earlier version of this had two bare
// `match` lines and therefore floated *every* Steam window, main client
// included, which was not the intent.

// The sign-in dialog. It comes up too short for its own content — the QR code
// below the password field gets cut off — so a minimum size is forced. This is
// an X11 window under xwayland-satellite, which reports a single scale (1x)
// when the outputs disagree, and Steam sizes itself from that.
window-rule {
    match app-id=r#"^steam$"# title=r#"^Sign in to Steam$"#
    open-floating true
    min-width 440
    min-height 470
}

// Tooltips and notification popups are separate X11 windows; floating them
// keeps them out of the scrolling strip. The main client is left to tile.
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_"#
    open-floating true
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true

    // Draw the focus ring *around* windows instead of as a solid rectangle
    // behind them.
    //
    // niri's default is behind, because a window using client-side decorations
    // can be any shape and the ring has to cover the whole area to look right.
    // The side effect is that the ring shows through anything semitransparent —
    // and kitty runs at background_opacity 0.92 (see ../../terminal/kitty.nix),
    // so 8% of a solid Ayu-blue rectangle bled through the entire terminal
    // whenever it had focus. It read as the window turning blue, not as a
    // focus indicator.
    //
    // prefer-no-csd above is meant to cover this, but only for windows that
    // actually negotiate server-side decorations; this rule is unconditional.
    // No visual difference on opaque windows.
    draw-border-with-background false
}

// Half width suits a terminal and is cramped for a browser. On eDP-1 a 0.5
// column is 785 logical pixels, and desktop sites start breaking their
// responsive layouts around there — x.com in particular overlaps its sidebar
// with the timeline and grows a horizontal scrollbar.
//
// These open full width instead. Mod+R still cycles them down when they need to
// share the screen; this only changes where they start.
window-rule {
    match app-id=r#"^brave-origin$"#
    match app-id=r#"^zen$"#
    match app-id=r#"^discord$"#
    match app-id=r#"^vesktop$"#
    match app-id=r#"^steam$"# title=r#"^Steam$"#
    default-column-width { proportion 1.0; }
}

// Floating windows are dialogs, and a dialog's content decides its size —
// nothing is going to resize it to fit. clip-to-geometry from the rule above
// cuts whatever does not fit instead of letting the window grow, which is how
// the Steam sign-in dialog lost the QR code off its bottom edge.
//
// The rounded corners stay; only the clipping is lifted.
window-rule {
    match is-floating=true
    clip-to-geometry false
}

binds {
    // "Mod" is Super on a TTY session, which is what SDDM starts.
    // Everything above the "niri-only" group keeps the shortcuts carried over
    // from the previous Hyprland session, so the muscle memory transfers.
    // Bindings with no counterpart there are grouped at the end.

    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- Noctalia IPC ---
    //
    // A bare SUPER tap opens the launcher. niri cannot bind a modifier on its
    // own — `Mod { ... }` is rejected outright — so keyd turns a tap-and-release
    // of left Super into this chord before niri ever sees it, while holding it
    // still behaves as the Meta modifier for every binding below.
    //
    // The chord looks arbitrary and is not: F13 was tried first and produces no
    // keysym under the `us` layout, so the binding could never fire. See
    // ../../keyboard.nix for the full explanation. Change it in both places or
    // in neither. Mod+Space stays as the explicit alternative.
    Ctrl+Alt+Shift+P { spawn "dms" "ipc" "spotlight" "toggle"; }
    Mod+Space        { spawn "dms" "ipc" "spotlight" "toggle"; }
    Mod+F1    { spawn "dms" "ipc" "control-center" "toggle"; }
    Mod+F2    { spawn "dms" "ipc" "settings" "toggle"; }
    Mod+F3    { spawn "dms" "ipc" "clipboard" "toggle"; }
    Mod+F4    { spawn "dms" "ipc" "powermenu" "toggle"; }
    Mod+L     { spawn "dms" "ipc" "lock" "lock"; }

    // The one downgrade from Noctalia. Its `window-switcher` drew a visual
    // Alt+Tab overlay; DMS has no IPC verb for one, and the `recent-windows`
    // switcher that dms/alttab.kdl styles is a niri feature whose bind action
    // this build does not expose — niri 26.04 rejects every spelling of it and
    // it is absent from the 133 actions `niri msg action --help` lists.
    //
    // focus-window-previous is niri's own and is the honest equivalent: it
    // toggles between the two most recent windows, which is what Alt+Tab is
    // used for in practice. Revisit when niri exposes the action.
    Alt+Tab   { focus-window-previous; }

    // --- Apps ---
    Mod+Return { spawn "kitty"; }
    Mod+E      { spawn "dolphin"; }
    Mod+K      { spawn "kate"; }

    // Brave on both W and B. W is the one asked for; B predates it and costs
    // nothing to keep.
    Mod+W      { spawn "brave-origin"; }
    Mod+B      { spawn "brave-origin"; }

    // The official client, not vesktop — it is the one in daily use. Note that
    // only vesktop takes Noctalia's palette (see the discord template note in
    // ../../noctalia.nix), so this is the window that stays its own colour.
    //
    // spawn-sh, not spawn, and the difference is the whole binding working or
    // silently doing nothing. discord in nixpkgs is not a binary but an FHS
    // sandbox: the wrapper execs `bwrap --die-with-parent`, which arms
    // PR_SET_PDEATHSIG. Under plain `spawn` niri's intermediate process is gone
    // by the time Discord finishes starting, the pdeathsig fires, and bwrap
    // takes the whole app down before a window ever maps — no error, no crash,
    // nothing in the journal, just a key that appears dead.
    //
    // spawn-sh keeps a shell as bwrap's parent for as long as Discord runs, so
    // the signal is never delivered. Verified both ways on 2026-08-14:
    // `niri msg action spawn -- discord` leaves zero processes and no window,
    // `spawn-sh` maps the window every time. Every other app bound in this file
    // is a normal binary and unaffected — this is the only bwrap one.
    Mod+D      { spawn-sh "discord"; }

    // Wallpaper shuffle moved off Mod+W to make room for the browser.
    Mod+Shift+W { spawn "wallpaper-rotate"; }

    // --- Window management ---
    Mod+Q repeat=false { close-window; }
    Mod+V { toggle-window-floating; }
    Mod+F { fullscreen-window; }
    Mod+Shift+F { toggle-windowed-fullscreen; }

    // Focus, on the arrow keys.
    //
    // niri's own convention is hjkl, but Mod+L is already the lock-screen bind
    // above and `niri validate` rejects the duplicate outright. Muscle memory
    // for locking the screen is worth more than vim keys, so the whole hjkl set
    // is left out rather than kept half-there. Mod+Comma / Mod+Period below are
    // the column manipulation the arrows cannot express anyway.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }

    // --- Workspaces, SUPER+1..0 ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // --- Monitors. eDP-1 is left, HDMI-A-1 is right. ---
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }

    // --- Hardware keys. Routed through Noctalia rather than handled by niri,
    // so its OSD shows. allow-when-locked is what keeps them working on the
    // lock screen. ---
    // The numbers are step sizes in percent and come from upstream's own niri
    // mapping (distro/nix/niri.nix at v1.5.3): 3 for volume, 5 for brightness.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "dms" "ipc" "audio" "increment" "3"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "dms" "ipc" "audio" "decrement" "3"; }
    XF86AudioMute         allow-when-locked=true { spawn "dms" "ipc" "audio" "mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "dms" "ipc" "audio" "micmute"; }

    // The trailing "" is the device argument, and empty means "the default
    // one" — that is upstream's own spelling, not a typo. `dms ipc brightness
    // list` names them: backlight:nvidia_0 is the panel, ddc:i2c-9 the MSI over
    // DDC, leds:asus::kbd_backlight the keyboard.
    XF86MonBrightnessUp   allow-when-locked=true { spawn "dms" "ipc" "brightness" "increment" "5" ""; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "brightness" "decrement" "5" ""; }

    // Naming the LED device explicitly: without it these would move the screen
    // backlight instead, since the default device is the panel.
    XF86KbdBrightnessUp   allow-when-locked=true { spawn "dms" "ipc" "brightness" "increment" "5" "leds:asus::kbd_backlight"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "brightness" "decrement" "5" "leds:asus::kbd_backlight"; }

    // Noctalia has no media-control IPC verb, so these use playerctl.
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }

    // --- Screenshots ---
    //
    // Print and Shift+Print go through the shell rather than niri. An earlier
    // revision pointed them at niri's own built-in screenshot instead, which
    // looks like the key doing nothing if you expect the shell's flow: niri
    // opens an interactive picker that needs Enter to confirm, whereas the
    // region capture is the one muscle memory was trained on.
    //
    // The DMS migration on 2026-08-10 repeated this exact mistake by binding
    // `dms ipc niri screenshot`, which is the same niri picker wearing a DMS
    // name. Read the flags below before changing these lines again.
    //
    // These use the `dms screenshot` CLI, NOT `dms ipc niri screenshot`. The
    // IPC verb delegates to niri's own picker and walks straight back into the
    // trap described above — it needs Enter to confirm and leaves the clipboard
    // empty. The CLI is the one that reproduces Noctalia's behaviour:
    //
    //   --no-confirm   capture on mouse release, no Enter. This single flag is
    //                  the difference between "it works" and "the key does
    //                  nothing", because the confirm step is invisible if you
    //                  are not expecting it.
    //   clipboard      on by default (--no-clipboard would turn it off), as
    //                  image/png, so it pastes into Discord or Brave directly.
    //   file           on by default too, into --dir below.
    //
    // --dir is passed explicitly rather than left to DMS's default so the path
    // keeps matching screenshot-path at the top of this file, which is what
    // niri's own captures (Alt+Print) still use. One directory, not two.
    //
    // Mod+Shift+S is the Windows / Snipping Tool muscle memory and is the one
    // that will actually get used; Print is kept because it costs nothing.
    Mod+Shift+S { spawn "dms" "screenshot" "region" "--no-confirm" "--dir" "/home/daf3r/Pictures/Screenshots"; }
    Print       { spawn "dms" "screenshot" "region" "--no-confirm" "--dir" "/home/daf3r/Pictures/Screenshots"; }
    Shift+Print { spawn "dms" "screenshot" "full" "--dir" "/home/daf3r/Pictures/Screenshots"; }

    // Region capture that opens in satty to annotate — arrows, boxes, blur —
    // and puts the annotated result back on the clipboard on Enter. See the
    // screenshot-annotate script in ../../apps.nix for why this is a separate
    // key rather than the default for every capture.
    Mod+Print   { spawn "screenshot-annotate"; }

    // niri's own screenshot UI is still reachable, just not on the Print keys
    // above. Its per-window capture has no Noctalia equivalent.
    Alt+Print       { screenshot; }
    Alt+Shift+Print { screenshot-window; }

    // --- niri-only. Nothing in the old session did these, which is rather the
    // point of the move. ---

    // The overview: a zoomed-out view of every workspace and window. The single
    // feature that most justifies the move here.
    Mod+O repeat=false { toggle-overview; }

    // Cycle the focused column through the preset widths defined in `layout`.
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { reset-window-height; }
    Mod+C { center-column; }

    // --- Putting several windows in one place ---
    //
    // niri has no dwindle/fibonacci layout: the screen is a viewport onto an
    // infinite strip, and windows never subdivide it. What it has instead is
    // columns that can hold more than one window.
    //
    // Mod+Comma pulls the window next door *into* the focused column, so the
    // two share one slot stacked vertically. Mod+Period pushes it back out into
    // its own column. That is the equivalent of a manual split.
    Mod+Comma  { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // ...and this makes a multi-window column render as *tabs* instead: one
    // window visible, an indicator listing the rest. It is niri's answer to
    // Hyprland's window groups and their groupbar, and it is bound to the same
    // key that did the equivalent thing there, so the habit transfers.
    Mod+G { toggle-column-tabbed-display; }

    // Move between the windows inside a column (or between tabs, when tabbed).
    // Mod+Up/Down above do this too; these are here because the muscle memory
    // for cycling a group is usually a Tab key.
    Mod+Tab       { focus-window-down-or-top; }
    Mod+Shift+Tab { focus-window-up-or-bottom; }

    // Scroll along the strip with the mouse wheel.
    Mod+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-column-left; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}

// DMS regenerates dms/colors.kdl from the active palette and it overrides the
// focus-ring colours set above — which is why these includes have to be last.
// This replaces Noctalia's noctalia.kdl, which worked the same way.
//
// The whole dms/ directory is written by the shell itself, is gitignored, and
// every file in it carries a DO-NOT-EDIT banner. DMS creates it on first run,
// so nothing has to be deployed by hand; `dms setup colors` recreates a missing
// one.
//
// Only two of the eight files it generates are included on purpose:
//
//   colors.kdl   the palette — the direct replacement for noctalia.kdl
//   alttab.kdl   styling for niri's recent-windows switcher
//
// layout.kdl is deliberately left out: it sets gaps, border widths and corner
// radii that this file already defines, and DMS's defaults are not the ones
// tuned here. wpblur.kdl is left out too — it only matters for DMS's own
// wallpaper surface, and awww draws the wallpaper on this machine (see
// ../../wallpaper.nix). binds.kdl, cursor.kdl, outputs.kdl and windowrules.kdl
// are generated empty unless configured in the GUI; outputs.kdl staying empty
// is what keeps DMS away from the monitor setup above.
// !! DMS EDITS THIS FILE BY ITSELF. CHECK `git status` AFTER TOUCHING ITS GUI. !!
//
// On 2026-08-10 it appended includes for layout.kdl, outputs.kdl and
// windowrules.kdl here on its own and left config.kdl.backup<timestamp> files
// beside this one. It was not a silent no-op: it edited the config to make its
// own fragments take effect.
//
// The outputs.kdl it generated would have undone the whole output block above:
//
//   output "eDP-1"     keyed on the connector name, which is exactly what the
//                      note up there says is NOT stable on this machine
//   scale 1.5          2560/1.5 = 1706.67, non-integer, the fractional-scaling
//                      blur that scale 1.6 exists to avoid
//   position y=120     undoes the bottom-edge alignment that keeps the cursor
//                      able to cross between the two outputs
//
// Because these includes come last, they win. There is no DMS setting that
// turns this off — `settings dump` has no toggle for it. The protection is that
// config/niri is a git-tracked directory, so the edit shows up as a diff
// instead of happening invisibly. That is how this one was caught, before a
// reboot made it real.
include "dms/colors.kdl"
include "dms/alttab.kdl"
